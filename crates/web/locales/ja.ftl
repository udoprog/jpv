# ウェブUIの文言。辞書の内容（語義）は翻訳しない。

not-found = ここには何もありません
loading = 読み込み中…
back = 戻る
save = 保存
cancel = キャンセル

language = 言語
language-option = { $native }（{ $english }）

index-id = ID
index-id-hint = 辞書の一意な識別子。[a-z]、[A-Z]、[0-9] のみ使用できます。
index-id-invalid = [a-z]、[A-Z]、[0-9] からなる空でない文字列にしてください。
index-format = 形式
index-url = URL
index-url-empty = 空にはできません
index-description = 説明
index-help = ヘルプページ
index-delete = 削除
index-update = 更新する
index-no-update = 更新しない

kanji-radicals = 部首
kanji-strokes = 画数

analyze-cycle = { $index } / { $count }（文字をクリックで切り替え）
analyze-hint = ヒント：
analyze-hint-text = 文字をクリックすると部分文字列を検索します

# sockel の文言のうち jpv で表示されるもの。
sockel-notice-dismiss = 閉じる
sockel-select-filter-label = 絞り込み
sockel-select-no-match = 一致なし
sockel-select-close = 閉じる
sockel-log-view-to-latest = 最新へ移動
sockel-log-view-new = 新着 { $count } 件
